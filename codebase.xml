            ].join(' ')
          }
        >
          <Icon size={20} weight="regular" />
          {label}
        </NavLink>
      ))}
    </nav>
  );
}

export function DesktopSidebar() {
  return (
    <aside className="hidden w-64 shrink-0 flex-col border-r border-outline-variant/60 bg-surface-container-lowest md:flex">
